<?xml version="1.0" encoding="gb2312"?>
<Config>
  <NpcModel mname="NPC_Default">
	<ActionList>
		<Action name="openUrl">
			<Param name="url" type="string"/>
			<Param name="size" type="enum" enum="large,small,full"/>
		</Action>
		<Action name="playGame">
			<Param name="id" type="string"/>
		</Action>
		<Action name="gotoHome">
			<Param name="uin" type="int"/>
		</Action>
		<Action name="enterScene">
			<Param name="id" type="int"/>
		</Action>
		<Action name="showIntro">
			<Param name="intro" type="string"/>
		</Action>
		<Action name="showAbstract">
			<Param name="abstract" type="string"/>
		</Action>
	</ActionList>
  </NpcModel>
</Config>